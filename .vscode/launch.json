{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PSU Pulse: run server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "jinja": true
    },
    {
      "name": "PSU Pulse: evaluate analyzer",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate_model.py",
      "args": ["database/sample_labeled_feedback.csv", "--errors"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
